# Copy to .env for local dev. On Vercel, add these under Project Settings > Environment Variables.

# Postgres connection string (Neon / Vercel Postgres). Leave empty locally to use SQLite.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
